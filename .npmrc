# DSH 0.1.5+ publishes pnpm-workspace peer closures (e.g. session-controller
# carries ~28 peers) that npm strict mode cannot satisfy outside the monorepo.
# These deps serve typecheck/tests only — the shipped lib/ bundles just this
# package's own sources — so peer conflicts are ignored; direct versions stay
# pinned in package.json as the single source of truth.
legacy-peer-deps=true
